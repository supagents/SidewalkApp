// ============================================================
// SIDEWALK — Firestore security rules (Firebase version)
// Paste this into Firebase Console → Firestore Database → Rules,
// or deploy with `firebase deploy --only firestore:rules`.
//
// Data model (Firestore is document/collection based, not tables):
//
// /campaigns/{campaignId}
//     name, createdBy, createdAt
//   /campaigns/{campaignId}/members/{uid}
//     role: 'manager' | 'volunteer', joinedAt
//   /campaigns/{campaignId}/invites/{inviteId}
//     email, role, invitedBy, token, status, createdAt, expiresAt
//   /campaigns/{campaignId}/canvasses/{canvassId}
//     name, createdBy, createdAt, updatedAt, shareable, shareCode
//     /streets/{streetId}
//       name, position
//       /houses/{houseId}
//         number, status, lawnSign, notes, updatedBy, updatedAt
//     /guests/{uid}
//       displayName, joinedAt
//       (written only by the joinCanvassByCode Cloud Function — grants
//       one anonymous-auth user access to this ONE canvass, not the
//       whole campaign)
//     /mapOverlays/{overlayId}
//       name, color, geojson, createdBy, createdAt
//       (user-uploaded boundary layer — ward, riding, poll division,
//       etc. — parsed client-side from GeoJSON/KML/Shapefile down to a
//       plain GeoJSON FeatureCollection before it's stored)
// /shareCodes/{code}
//     campaignId, canvassId, createdBy, createdAt
//     (join-code lookup for the share flow; the code itself is the doc
//     ID, so it's only reachable if you already know it)
// ============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Anonymous guests (isCanvassGuest below) never go through this — they
    // have no email at all, and that's fine, they're not real accounts.
    // Real accounts do: the app's own UI already blocks everything behind
    // VerifyEmailScreen until this is true, but that's only a client-side
    // route guard — nothing previously stopped an unverified account from
    // reading/writing directly through the SDK, bypassing that screen
    // entirely. Folding this into isMember/isManager (rather than
    // scattering the check everywhere they're used) makes every rule built
    // on top of them — including hasCanvassAccess's member branch — honor
    // it automatically.
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isMember(campaignId) {
      return isVerified() &&
        exists(/databases/$(database)/documents/campaigns/$(campaignId)/members/$(request.auth.uid));
    }

    function isManager(campaignId) {
      return isVerified() &&
        get(/databases/$(database)/documents/campaigns/$(campaignId)/members/$(request.auth.uid)).data.role == 'manager';
    }

    function isCanvassGuest(campaignId, canvassId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/campaigns/$(campaignId)/canvasses/$(canvassId)/guests/$(request.auth.uid));
    }

    function hasCanvassAccess(campaignId, canvassId) {
      return isMember(campaignId) || isCanvassGuest(campaignId, canvassId);
    }

    // request.auth.token.auth_time updates whenever the session actually
    // (re)authenticates — including reauthenticateWithCredential, which is
    // what the app calls right before deleting a campaign or canvass (see
    // ConfirmDeleteModal's password field). Requiring it to be recent on
    // those two deletes makes the password prompt a real server-side
    // check, not just a client-side dialog a hijacked session (e.g. via
    // an XSS payload, or a stolen token) could simply skip by calling the
    // SDK directly with an otherwise-valid, already-signed-in session.
    function recentlyReauthenticated() {
      return isSignedIn() &&
        (request.time.toMillis() / 1000 - request.auth.token.auth_time) < 300;
    }

    // ---------- campaigns ----------
    match /campaigns/{campaignId} {
      allow read: if isMember(campaignId);
      allow create: if isVerified() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isManager(campaignId);
      allow delete: if isManager(campaignId) && recentlyReauthenticated();

      // ---------- members ----------
      // Client apps never write member docs directly — that only
      // happens via the acceptInvite Cloud Function (see functions/index.js),
      // which runs with the Admin SDK and bypasses these rules entirely.
      // This keeps "join a team" atomic and token-verified server-side.
      // The delete here is the manager's own membership doc, cleaned up
      // as part of deleting their campaign (lib/campaign.ts's
      // deleteCampaign) — always immediately after the same
      // reauthentication as the campaign delete above, so this needs it
      // too, for the same reason.
      match /members/{uid} {
        allow read: if isMember(campaignId);
        allow delete: if isManager(campaignId) && recentlyReauthenticated();
        allow write: if false;
      }

      // ---------- invites ----------
      match /invites/{inviteId} {
        allow read, write: if isManager(campaignId);
      }

      // ---------- canvasses ----------
      // A canvass guest (joined by share code) can add and edit — create
      // and update — at every level here, but never delete: only a real
      // campaign member can delete a house, a street, or the canvass
      // itself. Without this split, hasCanvassAccess's blanket "write"
      // covers delete too, letting a guest remove the whole canvass doc
      // (or any street/house) with a direct write, regardless of what
      // the UI shows them.
      match /canvasses/{canvassId} {
        allow read: if hasCanvassAccess(campaignId, canvassId);
        allow create, update: if hasCanvassAccess(campaignId, canvassId);
        allow delete: if isManager(campaignId) && recentlyReauthenticated();

        // ---------- streets ----------
        match /streets/{streetId} {
          allow read: if hasCanvassAccess(campaignId, canvassId);
          allow create, update: if hasCanvassAccess(campaignId, canvassId);
          allow delete: if isMember(campaignId);

          // ---------- houses ----------
          match /houses/{houseId} {
            allow read: if hasCanvassAccess(campaignId, canvassId);
            allow create, update: if hasCanvassAccess(campaignId, canvassId);
            allow delete: if isMember(campaignId);
          }
        }

        // ---------- guests ----------
        // Written only by the joinCanvassByCode Cloud Function (Admin
        // SDK, bypasses these rules) — never directly by a client. This
        // scopes a guest's access to this one canvass, not the whole
        // campaign, unlike /members.
        match /guests/{uid} {
          allow read, write: if false;
        }

        // ---------- map overlays ----------
        // User-uploaded boundary layers (ward, riding, poll division, or
        // any other district) shown on this canvass's map. A guest can
        // see them (useful context while canvassing) but not upload or
        // remove one — that's treated as campaign setup, not day-of
        // canvassing data, same reasoning as canvass-level delete.
        match /mapOverlays/{overlayId} {
          allow read: if hasCanvassAccess(campaignId, canvassId);
          allow create, update, delete: if isMember(campaignId);
        }
      }
    }

    // ---------- shareCodes ----------
    // Doc ID is the code itself, so it's only reachable if you already
    // know it — there's no way to list/enumerate codes. A manager
    // creates one to turn sharing on; joinCanvassByCode (Cloud Function,
    // Admin SDK, bypasses these rules) reads it to resolve a code a guest
    // typed in. `allow read` would grant `list` too, not just `get` —
    // since this rule doesn't depend on the document at all, that would
    // let anyone enumerate every share code on the platform via a plain
    // collection query, no code-guessing needed. Only `get` is granted
    // (nothing in the client ever reads a code back anyway — it only
    // creates/deletes the one it generates), so a query against the
    // collection is rejected outright.
    match /shareCodes/{code} {
      allow get: if isSignedIn();
      allow create: if isManager(request.resource.data.campaignId)
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isManager(resource.data.campaignId);
    }

    // ---------- profiles ----------
    // Optional: only needed if you store display names outside auth.
    // Same `get`-not-`list` reasoning as shareCodes above — the client
    // only ever fetches its own profile by uid, never lists the
    // collection, so nothing here depends on `list` being allowed.
    match /profiles/{uid} {
      allow get: if isSignedIn();
      allow write: if isSignedIn() && uid == request.auth.uid;
    }
  }
}
